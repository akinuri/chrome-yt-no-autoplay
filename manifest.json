{
  "manifest_version": 3,
  "name": "YouTube No Autoplay",
  "version": "0.1",
  "description": "Stop videos from autoplaying.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}