{
  "manifest_version": 3,
  "name": "YouTube No Autoplay",
  "version": "0.1",
  "description": "Stop videos from autoplaying.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}